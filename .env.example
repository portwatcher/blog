# Public blog URL.
NUXT_PUBLIC_HOST=http://localhost:3000

# Decap writes entries to this private content repo.
NUXT_PUBLIC_CMS_CONTENT_REPO=owner/private-blog-content
NUXT_PUBLIC_CMS_CONTENT_BRANCH=main

# Nuxt Content reads the same repo at build/dev time.
# If omitted, it is derived from NUXT_PUBLIC_CMS_CONTENT_REPO as a GitHub HTTPS URL.
# BLOG_CONTENT_REPOSITORY=https://github.com/owner/private-blog-content.git
BLOG_CONTENT_AUTH_TOKEN=github_pat_or_deploy_token_with_read_access

# Public CDN/base URL used to render S3 object keys.
NUXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Generated translation languages read from the content repo.
NUXT_PUBLIC_TRANSLATION_LANGUAGES=zh,en,ja
NUXT_PUBLIC_ORIGINAL_LANGUAGE=zh

# Decap CMS auth.
# proxy-token keeps the server-side GitHub proxy and prompts for an admin token.
# github-oauth uses the "Login with GitHub" button; editors must have write access
# to NUXT_PUBLIC_CMS_CONTENT_REPO and the OAuth callback URL must be:
#   https://your-blog.example.com/admin/auth/callback
NUXT_PUBLIC_CMS_AUTH_MODE=proxy-token
NUXT_CMS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
NUXT_CMS_GITHUB_AUTH_TOKEN=github_pat_or_deploy_token_with_write_access
NUXT_CMS_GITHUB_OAUTH_CLIENT_ID=
NUXT_CMS_GITHUB_OAUTH_CLIENT_SECRET=
NUXT_CMS_GITHUB_OAUTH_SCOPE=repo

# Private CMS upload guard. Required in production unless github-oauth is enabled
# and editors authenticate with a GitHub token that can write to the content repo.
NUXT_CMS_UPLOAD_TOKEN=replace-with-a-long-random-token

# S3-compatible media storage. For AWS S3, endpoint and path style can stay empty.
NUXT_S3_BUCKET=blog-media
NUXT_S3_REGION=us-east-1
NUXT_S3_ENDPOINT=
NUXT_S3_FORCE_PATH_STYLE=false
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=
NUXT_S3_KEY_PREFIX=blog-media
NUXT_S3_MULTIPART_PART_SIZE_MB=10
NUXT_S3_MAX_UPLOAD_MB=2048
NUXT_S3_ALLOWED_CONTENT_TYPES=image/,video/

# Optional backup mirror. S3 remains the serving source; this writes a Git LFS
# copy into the content repo after each successful upload.
NUXT_CMS_LFS_BACKUP_ENABLED=false
NUXT_CMS_LFS_REPOSITORY=https://github.com/owner/private-blog-content.git
NUXT_CMS_LFS_BRANCH=main
NUXT_CMS_LFS_MEDIA_DIR=media
NUXT_CMS_LFS_AUTH_USERNAME=x-access-token
NUXT_CMS_LFS_AUTH_TOKEN=github_pat_or_deploy_token_with_write_access
NUXT_CMS_LFS_AUTHOR_NAME=Blog CMS
NUXT_CMS_LFS_AUTHOR_EMAIL=blog-cms@example.invalid

# Used by pnpm cms:s3-cors.
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000
