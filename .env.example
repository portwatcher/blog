# Public blog URL.
NUXT_PUBLIC_HOST=http://localhost:3000

# Decap writes entries to this private content repo.
NUXT_PUBLIC_CMS_CONTENT_REPO=owner/private-blog-content
NUXT_PUBLIC_CMS_CONTENT_BRANCH=main

# Nuxt Content reads the same repo at build/dev time.
# If omitted, it is derived from NUXT_PUBLIC_CMS_CONTENT_REPO as a GitHub HTTPS URL.
# BLOG_CONTENT_REPOSITORY=https://github.com/owner/private-blog-content.git
BLOG_CONTENT_AUTH_TOKEN=github_pat_or_deploy_token_with_read_access

# Public CDN/base URL used to render S3 object keys.
NUXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Private CMS upload guard. Required in production.
NUXT_CMS_UPLOAD_TOKEN=replace-with-a-long-random-token

# S3-compatible media storage. For AWS S3, endpoint and path style can stay empty.
NUXT_S3_BUCKET=blog-media
NUXT_S3_REGION=us-east-1
NUXT_S3_ENDPOINT=
NUXT_S3_FORCE_PATH_STYLE=false
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=
NUXT_S3_KEY_PREFIX=blog-media
NUXT_S3_MULTIPART_PART_SIZE_MB=10
NUXT_S3_MAX_UPLOAD_MB=2048
NUXT_S3_ALLOWED_CONTENT_TYPES=image/,video/

# Used by pnpm cms:s3-cors.
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000
